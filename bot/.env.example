# Copy to .env and fill in. Loaded automatically if python-dotenv is installed.

# --- required ---------------------------------------------------------------
# Telegram bot token from @BotFather.
BOT_TOKEN=123456:ABC-your-token-here

# Telegram numeric user id(s) allowed to run scans, space/comma separated.
# EMPTY = nobody can scan (the bot fails closed). Find your id via @userinfobot.
ALLOWED_USER_IDS=

# --- cyberfw wiring ---------------------------------------------------------
# The CS-TOOL checkout (holds registry.yaml, tools_bin/, reports/).
CYBERFW_WORKSPACE=..

# How to invoke the CLI. Examples:
#   cyberfw                     (installed on PATH via `uv tool install`)
#   uv run cyberfw              (run from the repo without installing)
#   python -m cyberfw.cli
CYBERFW_CMD=cyberfw

# Pipeline to run for /scan (a built-in name or a pipelines/<name>.yaml).
BOT_PIPELINE=recon-to-vuln

# Extra args appended to `cyberfw pipeline`, e.g. "--gowitness".
BOT_EXTRA_PIPELINE_ARGS=

# --- limits & safety --------------------------------------------------------
BOT_MAX_CONCURRENT=2          # simultaneous scans
BOT_SCAN_TIMEOUT=1800         # seconds, whole scan (bot-side wall clock)
BOT_STAGE_TIMEOUT=600         # seconds, per tool (passed as CYBERFW_STAGE_TIMEOUT)
BOT_BLOCK_PRIVATE=true        # refuse loopback/private IPs and localhost
BOT_MAX_FINDINGS=10           # findings shown inline before "see the report"

# Where scan history is kept (SQLite). Defaults to the workspace.
# BOT_DB=./bot-scans.sqlite3
